(*
    PyLike Language - EBNF Grammar
    ---------------------------------------------------------------
    A Python-flavored language whose blocks are delimited by '{' and '}'
    (indentation is NOT significant). Statements within a block are
    separated by ';'. Newlines are treated like ordinary whitespace.

    All other syntax follows Python conventions:
        - `and` / `or` / `not` for logical operations
        - `True` / `False` / `None` for built-in constants
        - `lambda params : expr` for anonymous functions
        - `a if cond else b` for ternary expressions
        - `def`, `class`, `import`, `for ... in ...`, `while`, `if/elif/else`
          all behave like Python, with braces instead of ':'+indentation
        - NO `try` / `except` / `catch` / `finally` blocks
        - NO class inheritance

    Extended operators (Python-compatible):
        - bitwise    |  ^  &  ~     (note: `|` doubles as type-union separator
                                     in type annotations, disambiguated by context)
        - shift      <<  >>
        - floor div  //           matmul @
        - full set of compound assignments including //= @= &= |= ^= <<= >>=
        - tuple literals `(a, b, c)` and set literals `{a, b, c}`
        - slicing     a[i:j:k]
        - tuple destructuring and assignable l-values (attr / index)

    Notation:
        =     production rule
        |     alternative
        { }   repetition, zero or more times
        [ ]   optional, zero or one time
        ( )   grouping
        " "   literal terminal
        ;     rule terminator
        (* *) comment
*)

(* ============================================================ *)
(*  Program                                                      *)
(* ============================================================ *)

program         = statement_list ;

statement_list  = { statement } ;


(* ------------------------------------------------------------ *)
(*  Statements                                                   *)
(*                                                                *)
(*  Note: '{' '}' at statement position is a *block*. At         *)
(*  expression position it is a *dict* or *set literal*; the      *)
(*  parser disambiguates by syntactic context.                  *)
(*                                                                *)
(*  Variables are introduced by plain assignment *statements*    *)
(*  (`x = 5;`) — Python-style, no `let` / `const` keyword.       *)
(*                                                                *)
(*  Assignment is a *statement* in Python — it produces no value   *)
(*  and may NOT appear inside another expression.                 *)
(* ------------------------------------------------------------ *)

statement       = import_stmt
                | func_decl
                | class_decl
                | if_stmt
                | while_stmt
                | for_stmt
                | return_stmt
                | break_stmt
                | continue_stmt
                | assignment_stmt
                | expr_stmt
                | block
                ;

block           = "{" statement_list "}" ;


(* ============================================================ *)
(*  Declarations                                                 *)
(* ============================================================ *)

import_stmt     = "import" identifier { "." identifier } [ "as" identifier ] ";" ;

func_decl       = "def" identifier "(" [ param_list ] ")" [ return_annot ] block ;
return_annot    = "->" type_expr ;

param_list      = parameter { "," parameter } ;
parameter       = identifier [ ":" type_expr ] [ "=" expression ] ;

(* Classes do not support inheritance - there is no parent/base class
   syntax. A class declares a name and a body of members only.         *)

class_decl      = "class" identifier "{" { class_member } "}" ;
class_member    = func_decl | assignment_stmt | expr_stmt ;


(* ============================================================ *)
(*  Control Flow                                                 *)
(* ============================================================ *)

if_stmt         = "if" expression block
                  { "elif" expression block }
                  [ "else" block ] ;

while_stmt      = "while" expression block ;

for_stmt        = "for" identifier "in" expression block ;

return_stmt     = "return" [ expression ] ";" ;
break_stmt      = "break" ";" ;
continue_stmt   = "continue" ";" ;

(* ------------------------------------------------------------ *)
(*  Assignment                                                   *)
(*                                                                *)
(*  Assignment is a *statement*, NOT an expression. It has no    *)
(*  value and cannot be embedded inside another expression       *)
(*  (e.g. `y = (x = 5)` is a SyntaxError).                        *)
(*                                                                *)
(*  The right-hand side of any assignment is a plain `expression` *)
(*  only - it cannot be another `assignment_stmt`. This means    *)
(*  chained assignment `a = b = 5` is rejected by the parser,    *)
(*  matching how most other languages (JS, C, Rust, Java) treat   *)
(*  assignment rather than how Python's grammar handles chains.  *)
(*                                                                *)
(*  Augmented assignments (+=, -=, *=, /=, //=, %=, **=, @=,     *)
(*  &=, |=, ^=, <<=, >>=) are also statements.                   *)
(*                                                                *)
(*  Supported LHS (assign_target) shapes:                        *)
(*     x           plain identifier                              *)
(*     x.y         attribute (single level)                      *)
(*     x[i]        index  (single level, index only - not slice) *)
(*     (a, b, c)   tuple destructure (identifiers only)          *)
(* ------------------------------------------------------------ *)

assign_target   = identifier
                | identifier "." identifier
                | identifier "[" expression "]"
                | "(" identifier { "," identifier } ")"
                ;

assignment_stmt = assign_target assign_op expression ;

assign_op       = "="
                | "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "**=" | "@="
                | "&=" | "|=" | "^=" | "<<=" | ">>="
                ;

expr_stmt       = expression ";" ;


(* ============================================================ *)
(*  Expressions                                                  *)
(*                                                                *)
(*  Operator precedence (low -> high):                           *)
(*    1.  lambda                                                  *)
(*    2.  ternary          a if cond else b                        *)
(*    3.  logical-or       or                                      *)
(*    4.  logical-and      and                                     *)
(*    5.  logical-not      not                                     *)
(*    6.  comparison       == !=  < <=  > >=  in  not in  is  is not  *)
(*    7.  bitwise-or       |                                       *)
(*    8.  bitwise-xor      ^                                       *)
(*    9.  bitwise-and      &                                       *)
(*   10.  shift            << >>                                   *)
(*   11.  additive         +  -                                    *)
(*   12.  multiplicative   *  /  //  %  @                          *)
(*   13.  unary            -  +  ~                                 *)
(*   14.  power            **  (right-associative)                 *)
(*   15.  postfix          ()  []  .  [:]                          *)
(*   16.  primary                                                 *)
(* ============================================================ *)

(* Note: assignment is a *statement* (see the Assignment section  *)
(* above) and is NOT part of the expression grammar. It cannot be   *)
(* used inside another expression. Only `lambda_expr` and          *)
(* `ternary_expr` (which subsumes everything below it) are the    *)
(* top-level expression shapes.                                     *)

expression      = lambda_expr | ternary_expr ;

ternary_expr    = logical_or [ "if" logical_or "else" expression ] ;

logical_or      = logical_and { "or" logical_and } ;
logical_and     = not_expr { "and" not_expr } ;

not_expr        = "not" not_expr | comparison ;

comparison      = bitwise_or { comp_op bitwise_or } ;
comp_op         = "==" | "!=" | "<" | "<=" | ">" | ">="
                | "in"
                | "not" "in"
                | "is"
                | "is" "not"
                ;

bitwise_or      = bitwise_xor { "|" bitwise_xor } ;
bitwise_xor     = bitwise_and { "^" bitwise_and } ;
bitwise_and     = shift { "&" shift } ;
shift           = additive { ( "<<" | ">>" ) additive } ;

additive        = multiplicative { ( "+" | "-" ) multiplicative } ;
multiplicative  = unary { ( "*" | "/" | "//" | "%" ) unary } ;

unary           = ( "-" | "+" | "~" ) unary | power ;
power           = postfix [ "**" unary ] ;

postfix         = primary { postfix_op } ;
postfix_op      = "(" [ arg_list ] ")"
                | "[" slice "]"
                | "." identifier
                ;

(* Slice / index in postfix `[ ]`:
     a[i]          index
     a[i:j]        slice start..end
     a[i:j:k]      slice with step
     a[i:]         slice to end
     a[:j]         slice from start
     a[:]          full-slice copy
     a[:j:k]       slice from start with step
   Disambiguation: if the first token after `[` is `:`, it's a slice
   starting with `:`; otherwise the first expression is parsed and `:` is
   checked for the optional tail.                                         *)
slice           = expression [ ":" [ expression ] [ ":" [ expression ] ] ]
                | ":" [ expression ] [ ":" [ expression ] ]
                ;

arg_list        = expression { "," expression } ;

primary         = literal
                | identifier
                | tuple_or_grouped
                | list_literal
                | dict_or_set_literal
                ;

(* Tuple vs grouped-expression disambiguation:
     ()            empty tuple
     (x)           parenthesized expression
     (x,)          single-element tuple
     (x, y, z)     tuple
   The presence of an interior or trailing comma forces tuple form.       *)
tuple_or_grouped = "(" ")"
                  | "(" expression { "," expression } ")"   (* tuple, >= 1 element *)
                  | "(" expression ")"                     (* grouped *)
                  ;


(* ============================================================ *)
(*  Lambda                                                       *)
(*                                                                *)
(*  Python-style: lambda params : expression                      *)
(*  Parameters are plain identifiers (no type annotations or     *)
(*  default values - matches Python). The body is a single        *)
(*  expression, not a block.                                      *)
(* ============================================================ *)

lambda_expr     = "lambda" [ lambda_params ] ":" expression ;
lambda_params   = identifier { "," identifier } ;


(* ============================================================ *)
(*  Literals                                                     *)
(* ============================================================ *)

literal         = number | string_literal | boolean | "None" ;

number          = integer | float ;
integer         = digit { digit } ;
float           = digit { digit } "." digit { digit }
                  [ ( "e" | "E" ) [ "+" | "-" ] digit { digit } ]
                ;

string_literal  = '"'  { string_char_double }   '"'
                | "'"  { string_char_single }   "'"
                ;
(* string_char includes any character except the surrounding quote
   and a literal newline, plus common escape sequences \n \t \r \\ \" \' *)

boolean         = "True" | "False" ;

list_literal    = "[" [ expression { "," expression } ] "]" ;

(* Dict vs Set disambiguation:
     {}            empty dict   (empty set has no literal form)
     {k: v, ...}   dict literal
     {x, y, z}     set literal
   The parser distinguishes dict from set by inspecting the first
   separator after the first expression: ':' begins a dict entry,
   ',' / '}' marks a set element.                                       *)
dict_or_set_literal = "{" [ dict_or_set_content ] "}" ;
dict_or_set_content = expression
                      ( ":" expression { "," dict_entry }   (* dict form *)
                      | { "," expression }                  (* set form  *)
                      ) ;

dict_entry      = expression ":" expression ;


(* ============================================================ *)
(*  Types                                                        *)
(*                                                                *)
(*  Type annotations are always optional and follow the          *)
(*  standard union / generic / callable syntax used in Python's   *)
(*  typing module.                                                *)
(*                                                                *)
(*  Disambiguation note: `|` inside a `type_expr` is a type       *)
(*  union separator; in regular expression position it is         *)
(*  bitwise OR. The parser selects the meaning by syntactic      *)
(*  context (annotation slot vs. value position).                 *)
(* ============================================================ *)

type_expr       = union_type ;
union_type      = primary_type { "|" primary_type } ;

primary_type    = identifier
                | list_type
                | dict_type
                | func_type
                | "(" type_expr ")"
                ;

list_type       = "list" "[" type_expr "]" ;
dict_type       = "dict" "[" type_expr "," type_expr "]" ;

func_type       = "(" [ type_expr { "," type_expr } ] ")" "->" type_expr ;


(* ============================================================ *)
(*  Lexical Helpers                                              *)
(* ============================================================ *)

identifier      = ( letter | "_" ) { letter | digit | "_" } ;
letter          = "A" | "B" | ... | "Z" | "a" | "b" | ... | "z" ;
digit           = "0" | "1" | ... | "9" ;